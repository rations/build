// Pivuan: fastfetch shows the Pivuan logo (fastfetch picks its logo by ID in /etc/os-release,
// which stays "devuan"). Installed by the board support package; a user's own
// ~/.config/fastfetch/config.jsonc is used instead of this file.
// $1 grey (the v and its traces), $2 red (the i's dot and the middle trace), $3 the terminal's color.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/pivuan/fastfetch/pivuan.txt",
    "color": {
      "1": "38;2;150;150;152",
      "2": "38;2;208;2;27",
      "3": "39"
    }
  },
  "display": {
    "color": {
      "keys": "38;2;208;2;27",
      "title": "38;2;208;2;27"
    }
  },
  // fastfetch's default modules: a config file without this list shows none.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
