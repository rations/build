#!/bin/bash
#
# Armbian MOTD: Featured (news, apps and tips)
#

THIS_SCRIPT="tips"
MOTD_DISABLE=""

safe_source() { [[ -f "$1" ]] && . "$1"; }

safe_source /etc/default/armbian-motd
for f in ${MOTD_DISABLE}; do
  [[ "${f}" == "${THIS_SCRIPT}" ]] && exit 0
done

# --- helpers ---
_has_prev_output() {
  [[ -e /run/armbian-motd/.after_header.printed ]] \
  || [[ -e "${XDG_RUNTIME_DIR:-/tmp}/armbian-motd/.after_header.printed" ]]
}

# --- collect content ---

lines=()
heading="Featured"

# Not Armbian (e.g. Pivuan): no Armbian quotes or recommendations. Until a
# desktop is installed (pivuan-config writes /etc/armbian/desktop/<de>.tier),
# say how to install one.
safe_source /etc/armbian-release
if [[ -n "${VENDOR:-}" && "${VENDOR}" != Armbian* ]]; then
  heading="Tips"   # Pivuan's install hints, not Armbian's featured feed
  if command -v pivuan-config >/dev/null 2>&1 && ! compgen -G '/etc/armbian/desktop/*.tier' >/dev/null; then
    # Pivuan Audio first: it is what Pivuan is made for.
    lines+=("To install Pivuan Audio run pivuan-config --cmd AUDI01")
    lines+=("To install XFCE desktop run pivuan-config --cmd XFCE01")
    lines+=("To install MATE desktop run pivuan-config --cmd MATE01")
    lines+=("To install SonicDE run pivuan-config --cmd SONI01")
  fi
else
  # Featured feed (https://github.armbian.com/featured.json), cached daily by
  # /etc/cron.daily/armbian-featured. Pick a random type first, so the many
  # software entries don't crowd out news and the rest. Skip a stale cache.
  featured="/var/lib/armbian/featured.json"
  if [[ -n "$(find "$featured" -mtime -14 2>/dev/null)" ]] && command -v jq >/dev/null 2>&1; then
    mapfile -t tip < <(jq -r --arg today "$(date +%Y-%m-%d)" --argjson r1 "$RANDOM" --argjson r2 "$RANDOM" '
      [.entries[] | select((.expires // "") == "" or .expires >= $today) | select((.motd.line // "") != "")]
      | group_by(.type) | select(length > 0)
      | .[$r1 % length] | .[$r2 % length]
      | .motd.line, (.motd.hint // "")' "$featured" 2>/dev/null)
    [[ -n "${tip[0]}" ]] && lines+=("${tip[0]}")
    [[ -n "${tip[1]}" ]] && lines+=("${tip[1]}")
  fi
fi

# --- print (only if we actually have something to say) ---

if ((${#lines[@]})); then
  # One blank line ONLY if something printed earlier
  _has_prev_output && echo ""

  printf "\e[0;90m %s:\x1B[0m\n\n" "$heading"
  for l in "${lines[@]}"; do
    printf "%s\n" " $l"
  done
fi

exit 0
