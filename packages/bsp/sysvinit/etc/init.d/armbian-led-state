#!/bin/sh
### BEGIN INIT INFO
# Provides:          armbian-led-state
# Required-Start:    $local_fs
# Required-Stop:     $local_fs
# Default-Start:     S
# Default-Stop:      0 6
# Short-Description: Armbian LED state
### END INIT INFO
#
# sysvinit (Devuan / Pivuan) counterpart of armbian-led-state.service: runs /usr/lib/armbian/armbian-led-state-restore.sh.
# Shipped in the BSP only when the image is built with INIT_SYSTEM=sysvinit.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PROG=/usr/lib/armbian/armbian-led-state-restore.sh
STOP_PROG=/usr/lib/armbian/armbian-led-state-save.sh

[ -x "${PROG}" ] || exit 0

# shellcheck source=/dev/null
. /lib/lsb/init-functions

case "$1" in
	start)
		log_action_begin_msg "Armbian LED state"
		"${PROG}" start
		log_action_end_msg $?
		;;
	stop)
		log_action_begin_msg "Armbian LED state (stop)"
		"${STOP_PROG}"
		log_action_end_msg $?
		;;
	restart | force-reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force-reload}" >&2
		exit 3
		;;
esac

exit 0
