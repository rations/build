#!/bin/sh
### BEGIN INIT INFO
# Provides:          armbian-hardware-optimize
# Required-Start:    $local_fs
# Required-Stop:
# Should-Start:      armbian-hardware-monitor
# Default-Start:     S
# Default-Stop:
# Short-Description: Armbian hardware optimization
### END INIT INFO
#
# sysvinit (Devuan / Pivuan) counterpart of armbian-hardware-optimize.service: runs /usr/lib/armbian/armbian-hardware-optimization.
# Shipped in the BSP only when the image is built with INIT_SYSTEM=sysvinit.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PROG=/usr/lib/armbian/armbian-hardware-optimization

[ -x "${PROG}" ] || exit 0

# Output goes to /run/armbian-init.log, not the console (under systemd it goes to the journal).

# shellcheck source=/dev/null
. /lib/lsb/init-functions

case "$1" in
	start)
		log_action_begin_msg "Armbian hardware optimization"
		"${PROG}" start < /dev/null >> /run/armbian-init.log 2>&1
		log_action_end_msg $?
		;;
	stop | restart | force-reload)
		# Nothing to undo: this only runs once at boot.
		;;
	*)
		echo "Usage: $0 {start}" >&2
		exit 3
		;;
esac

exit 0
