#!/bin/sh
### BEGIN INIT INFO
# Provides:          armbian-firstrun
# Required-Start:    $local_fs $remote_fs $syslog
# Required-Stop:
# Should-Start:      ssh
# Default-Start:     2 3 4 5
# Default-Stop:
# Short-Description: Armbian first run tasks
### END INIT INFO
#
# sysvinit (Devuan / Pivuan) counterpart of armbian-firstrun.service: runs /usr/lib/armbian/armbian-firstrun.
# Shipped in the BSP only when the image is built with INIT_SYSTEM=sysvinit.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Never let debconf (e.g. dpkg-reconfigure openssh-server) wait for answers on a console.
export DEBIAN_FRONTEND=noninteractive
PROG=/usr/lib/armbian/armbian-firstrun

[ -x "${PROG}" ] || exit 0

# shellcheck source=/dev/null
. /lib/lsb/init-functions

# Same variables the systemd unit passes with EnvironmentFile=.
if [ -f /etc/default/armbian-firstrun ]; then
	set -a
	# shellcheck source=/dev/null
	. /etc/default/armbian-firstrun
	set +a
fi

case "$1" in
	start)
		# As with the systemd unit: run in the background, detached from the console, so the boot and the
		# login prompt don't wait for it and nothing can prompt or print on the console. It keeps its own log.
		setsid -f "${PROG}" start < /dev/null >> /run/armbian-init.log 2>&1
		log_action_msg "Armbian first run tasks started in the background"
		;;
	stop | restart | force-reload)
		# Nothing to undo: this only runs once at boot.
		;;
	*)
		echo "Usage: $0 {start}" >&2
		exit 3
		;;
esac

exit 0
